# Les valeurs sont tirées de l'environnement du shell qui lance kamal — jamais
# écrites ici. Kamal NE CHARGE PAS .env : il faut les exporter à chaque invocation.
#
#   export KAMAL_REGISTRY_PASSWORD=$(gh auth token)
#   export BASIC_AUTH_USER=... BASIC_AUTH_PASSWORD=...
#
KAMAL_REGISTRY_PASSWORD=$KAMAL_REGISTRY_PASSWORD
RAILS_MASTER_KEY=$(cat config/master.key)
BASIC_AUTH_USER=$BASIC_AUTH_USER
BASIC_AUTH_PASSWORD=$BASIC_AUTH_PASSWORD

<% content_for :title, "Cibles nutritionnelles" %>

<p class="text-xs uppercase tracking-widest text-stone-400">Étape 2</p>
<h1 class="mt-1 text-3xl font-semibold tracking-tight">Cibles nutritionnelles</h1>
<p class="mt-2 max-w-3xl text-stone-600">
  Une cible porte ses quatre minimums quotidiens, ses marges d'arrondi et sa répartition sur la journée.
  Changer d'objectif revient à modifier une ligne, puis à relancer le solveur — jamais à toucher au code.
</p>

<div class="mt-7 space-y-5">
  <% @targets.each do |target| %>
    <section class="rounded border <%= target.active? ? 'border-stone-900' : 'border-stone-200' %> bg-white p-6">
      <div class="mb-4 flex flex-wrap items-baseline justify-between gap-3">
        <h2 class="text-lg font-semibold tracking-tight">
          <%= target.name %>
          <% if target.active? %>
            <span class="ml-2 rounded bg-stone-900 px-2 py-0.5 text-[10px] uppercase tracking-wider text-white">active</span>
          <% end %>
          <span class="ml-2 text-xs font-normal text-stone-400"><%= target.source %></span>
        </h2>
        <p class="text-xs tabular-nums text-stone-500">
          Plancher : <%= kcal target.floor_kcal %> kcal ·
          <% if target.resolved? %>
            résolue <%= l target.resolved_at, format: :short %>
            <% if target.stale? %><span class="text-amber-600">· à recalculer</span><% end %>
          <% else %>
            <span class="text-amber-600">jamais résolue</span>
          <% end %>
        </p>
      </div>

      <%= form_with model: target, url: nutrition_target_path(target), method: :patch,
                    class: "flex flex-wrap items-end gap-3" do |f| %>
        <label class="block">
          <span class="text-[10px] uppercase tracking-wider text-stone-400">Nom</span>
          <%= f.text_field :name, class: "mt-1 w-56 rounded border border-stone-300 px-2 py-1.5 text-sm" %>
        </label>
        <% [[:protein, "Protéines"], [:lipid, "Lipides"], [:carb, "Glucides"], [:fiber, "Fibres"]].each do |field, label| %>
          <label class="block">
            <span class="text-[10px] uppercase tracking-wider text-stone-400"><%= label %></span>
            <%= f.number_field field, step: 1,
                  class: "mt-1 w-24 rounded border border-stone-300 px-2 py-1.5 text-sm tabular-nums" %>
          </label>
        <% end %>
        <%= f.submit "Enregistrer",
              class: "rounded border border-stone-300 px-4 py-2 text-sm hover:border-stone-500" %>
      <% end %>

      <div class="mt-4 flex flex-wrap items-center gap-3">
        <% unless target.active? %>
          <%= button_to "Rendre active", activate_nutrition_target_path(target),
                class: "rounded border border-stone-300 px-4 py-2 text-sm hover:border-stone-500" %>
        <% end %>
        <%= button_to "Recalculer les 16 semaines", recalculate_nutrition_target_path(target),
              class: "rounded bg-stone-900 px-4 py-2 text-sm font-medium text-white hover:bg-stone-700" %>
        <span class="text-xs text-stone-500">48 plats et 24 recettes fixes, environ 800 ms.</span>
      </div>

      <table class="mt-5 w-full max-w-2xl text-sm">
        <thead class="text-[10px] uppercase tracking-wider text-stone-400">
          <tr><th class="py-1 text-left">Répartition</th><th class="py-1 text-right">Prises/jour</th>
              <th class="py-1 text-right">Protéines</th><th class="py-1 text-right">Lipides</th>
              <th class="py-1 text-right">Glucides</th></tr>
        </thead>
        <tbody class="divide-y divide-stone-100">
          <% target.meal_shares.each do |share| %>
            <tr>
              <td class="py-1.5"><%= share.label %></td>
              <td class="py-1.5 text-right tabular-nums"><%= share.servings_per_day %></td>
              <% %i[protein_share lipid_share carb_share].each do |attr| %>
                <td class="py-1.5 text-right tabular-nums text-stone-500">
                  <%= number_to_percentage share.public_send(attr).to_f * 100, precision: 1 %>
                </td>
              <% end %>
            </tr>
          <% end %>
        </tbody>
      </table>
    </section>
  <% end %>
</div>

<section class="mt-8 rounded border border-dashed border-stone-300 p-6">
  <h2 class="mb-4 text-[10px] font-semibold uppercase tracking-widest text-stone-500">Nouvelle cible</h2>
  <%= form_with model: NutritionTarget.new, url: nutrition_targets_path,
                class: "flex flex-wrap items-end gap-3" do |f| %>
    <label class="block">
      <span class="text-[10px] uppercase tracking-wider text-stone-400">Nom</span>
      <%= f.text_field :name, placeholder: "Ma cible", required: true,
            class: "mt-1 w-56 rounded border border-stone-300 px-2 py-1.5 text-sm" %>
    </label>
    <% [[:kcal, "kcal", 1864], [:protein, "Protéines", 117], [:lipid, "Lipides", 93],
        [:carb, "Glucides", 130], [:fiber, "Fibres", 19]].each do |field, label, default| %>
      <label class="block">
        <span class="text-[10px] uppercase tracking-wider text-stone-400"><%= label %></span>
        <%= f.number_field field, value: default, step: 1, required: true,
              class: "mt-1 w-24 rounded border border-stone-300 px-2 py-1.5 text-sm tabular-nums" %>
      </label>
    <% end %>
    <%= f.submit "Créer",
          class: "rounded bg-stone-900 px-4 py-2 text-sm font-medium text-white hover:bg-stone-700" %>
  <% end %>
  <p class="mt-3 text-xs text-stone-500">
    La répartition sur la journée est reprise de la cible active. Le champ kcal est informatif :
    le plancher réel découle des quatre macronutriments.
  </p>
</section>

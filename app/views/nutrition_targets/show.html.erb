<% content_for :title, "Cibles nutritionnelles" %>

<%# Mobile : mode Réglages, en-tête blanc avec retour — pas de bandeau partagé. %>
<div class="-mx-5 -mt-8 border-b border-ash-200 bg-white px-4 pb-3.5 pt-3 lg:hidden">
  <%= link_to "‹ Accueil", weeks_path, class: "flex h-11 items-center text-sm font-semibold text-chloro-700" %>
  <p class="text-2xl font-extrabold tracking-tight text-ash-900">Cibles nutritionnelles</p>
  <p class="mt-0.5 text-[13px] text-ash-500">Étape 2 · configuration</p>
</div>

<p class="hidden text-xs font-bold uppercase tracking-widest text-chloro-700 lg:block">Étape 2</p>
<h1 class="mt-1 hidden text-3xl font-extrabold tracking-tight text-ash-900 lg:block">Cibles nutritionnelles</h1>
<p class="mt-2 max-w-3xl text-ash-500">
  Votre cible porte ses quatre minimums quotidiens, ses marges d'arrondi et sa répartition sur la journée.
  La modifier revient à changer une ligne, puis à relancer le solveur — jamais à toucher au code.
</p>

<div class="-mx-5 bg-ash-100 px-5 pb-8 pt-5 lg:mx-0 lg:bg-transparent lg:px-0 lg:pb-0 lg:pt-7">
  <section class="overflow-hidden rounded-xl border border-chloro-700 bg-white">
    <div class="flex flex-wrap items-center justify-between gap-3 bg-chloro-50 px-5 py-3.5">
      <span class="text-[15px] font-bold text-ash-900">Plancher <%= kcal @target.floor_kcal %> kcal</span>
      <span class="text-xs tabular-nums text-ash-500">
        <% if @target.resolved? %>
          résolue <%= l @target.resolved_at, format: :short %>
          <% if @target.stale? %><span class="text-amber-600">· à recalculer</span><% end %>
        <% else %>
          <span class="text-amber-600">jamais résolue</span>
        <% end %>
      </span>
    </div>

    <%# Niveau "Routine" : 48px, contour, inactif tant que rien n'a changé. %>
    <%= form_with model: @target, url: nutrition_target_path, method: :patch,
                  data: { controller: "dirty-save" } do |f| %>
      <% [[:protein, "Protéines"], [:lipid, "Lipides"], [:carb, "Glucides"], [:fiber, "Fibres"]].each do |field, label| %>
        <label class="flex min-h-14 items-center justify-between gap-4 border-b border-ash-100 px-5 last:border-0">
          <span class="text-[15px] text-ash-900"><%= label %></span>
          <span class="flex items-center gap-2">
            <%= f.number_field field, step: 1, inputmode: "decimal", data: { action: "input->dirty-save#markDirty" },
                  class: "w-24 rounded-lg border border-ash-300 bg-white px-3 py-2 text-right text-[15px] font-semibold tabular-nums text-ash-900 focus:border-chloro-500 focus:outline focus:outline-2 focus:outline-chloro-100" %>
            <span class="w-4 text-xs font-medium text-ash-500">g</span>
          </span>
        </label>
      <% end %>
      <div class="p-5">
        <%= f.submit "Enregistrer", disabled: true, data: { "dirty-save-target": "submit" },
              class: "flex h-12 w-full items-center justify-center rounded-lg border-[1.5px] border-chloro-700 px-4 text-sm font-bold text-chloro-700 hover:bg-chloro-50 disabled:cursor-not-allowed disabled:border-ash-300 disabled:text-ash-500 sm:w-auto" %>
      </div>
    <% end %>

    <%# Niveau "Lourde" : bande chloro-950 dédiée, confirmation en deux temps puis
        barre de progression chronométrée (aucun événement de progression réel côté
        serveur, le recalcul est un POST synchrone ~800 ms). %>
    <div class="bg-chloro-950 px-5 py-[18px]" data-controller="heavy-action">
      <p class="text-[10px] font-bold uppercase tracking-widest text-chloro-300">Action lourde · ≈ 1 s</p>
      <p class="mt-1.5 text-[17px] font-extrabold tracking-tight text-white">Recalculer les 16 semaines</p>
      <p class="mt-1.5 max-w-md text-[13px] leading-snug text-chloro-200">
        Régénère les grammages des 48 plats et des 24 recettes fixes, puis remplace le menu de toutes les semaines.
      </p>

      <%= form_with url: recalculate_nutrition_target_path, method: :post,
                    data: { "heavy-action-target": "form" } do %><% end %>

      <div data-heavy-action-target="idle" class="mt-3.5">
        <button type="button" data-action="click->heavy-action#ask"
                class="h-[52px] rounded-lg px-5 text-sm font-bold <%= @target.stale? ? 'bg-white text-chloro-950' : 'border-[1.5px] border-chloro-700 text-chloro-200 hover:bg-chloro-900' %>">
          Recalculer
        </button>
      </div>

      <div data-heavy-action-target="confirm" hidden class="mt-3.5 rounded-lg bg-chloro-800 p-3.5">
        <p class="text-[15px] font-bold text-white">Remplacer le menu des 16 semaines ?</p>
        <p class="mt-1 text-[13px] leading-snug text-chloro-200">
          Les grammages de chaque semaine seront remplacés par la nouvelle résolution.
        </p>
        <div class="mt-3 flex gap-2">
          <button type="button" data-action="click->heavy-action#cancel"
                  class="h-[48px] flex-1 rounded-lg border-[1.5px] border-chloro-400 text-sm font-semibold text-chloro-200">Annuler</button>
          <button type="button" data-action="click->heavy-action#go"
                  class="h-[48px] flex-[1.5] rounded-lg bg-white text-sm font-extrabold text-chloro-950">Confirmer le recalcul</button>
        </div>
      </div>

      <div data-heavy-action-target="running" hidden class="mt-3.5">
        <div class="h-2.5 overflow-hidden rounded-full bg-chloro-800">
          <div data-heavy-action-target="bar" class="h-full rounded-full bg-zest-400" style="width: 0%"></div>
        </div>
        <p class="mt-2 text-[13px] font-semibold text-chloro-200">Résolution en cours…</p>
      </div>

      <p class="mt-3 text-[11px] text-chloro-300">48 plats et 24 recettes fixes, environ 800 ms.</p>
    </div>

    <div class="border-t border-ash-100 px-5 py-5">
      <p class="mb-2.5 text-[10px] font-bold uppercase tracking-widest text-ash-500">Répartition sur la journée</p>
      <div class="grid gap-2.5 sm:grid-cols-3">
        <% @target.meal_shares.each do |share| %>
          <div class="rounded-lg border border-ash-200 p-3.5">
            <div class="flex items-baseline justify-between gap-2">
              <span class="text-sm font-semibold text-ash-900"><%= share.label %></span>
              <span class="flex-none text-xs font-bold tabular-nums text-chloro-700"><%= share.servings_per_day %>×/jour</span>
            </div>
            <div class="mt-2 grid grid-cols-3 gap-1.5">
              <% [[:protein_share, "Prot."], [:lipid_share, "Lip."], [:carb_share, "Gluc."]].each do |attr, label| %>
                <div class="rounded bg-chloro-50 px-1.5 py-1.5 text-center">
                  <p class="text-[8.5px] font-bold uppercase tracking-widest text-chloro-700"><%= label %></p>
                  <p class="mt-0.5 text-xs font-bold tabular-nums text-chloro-900">
                    <%= number_to_percentage share.public_send(attr).to_f * 100, precision: 1 %>
                  </p>
                </div>
              <% end %>
            </div>
          </div>
        <% end %>
      </div>
    </div>
  </section>
</div>

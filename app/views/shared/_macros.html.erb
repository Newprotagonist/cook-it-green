<dl class="grid grid-cols-3 gap-1.5 sm:grid-cols-5">
  <div class="rounded-lg bg-chloro-700 px-3 py-2.5">
    <dt class="text-[9px] font-bold uppercase tracking-widest text-chloro-200">kcal</dt>
    <dd class="mt-0.5 text-lg font-bold tabular-nums text-white"><%= kcal(macros.kcal) %></dd>
  </div>
  <% [["Prot.", grams(macros.protein)], ["Lip.", grams(macros.lipid)],
      ["Gluc.", grams(macros.carb)], ["Fibres", grams(macros.fiber)]].each do |label, value| %>
    <div class="rounded-lg bg-chloro-50 px-3 py-2.5">
      <dt class="text-[9px] font-bold uppercase tracking-widest text-chloro-600"><%= label %></dt>
      <dd class="mt-0.5 text-lg font-bold tabular-nums text-chloro-900"><%= value %></dd>
    </div>
  <% end %>
</dl>

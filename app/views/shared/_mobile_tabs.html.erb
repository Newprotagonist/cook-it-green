<%# locals: items — array of [label, path, active?], dark (mode Cuisine, défaut false) %>
<% dark = local_assigns.fetch(:dark, false) %>
<nav class="fixed inset-x-0 bottom-0 z-20 grid <%= dark ? "bg-chloro-950" : "bg-chloro-700" %> pb-[env(safe-area-inset-bottom)] lg:hidden"
     style="grid-template-columns: repeat(<%= items.size %>, minmax(0, 1fr))">
  <% items.each do |label, path, active| %>
    <%= link_to label, path,
          class: "flex h-14 items-center justify-center text-sm #{active ? 'font-bold text-white shadow-[inset_0_3px_0_#C2EC33]' : (dark ? 'font-medium text-chloro-300' : 'font-medium text-chloro-200')}" %>
  <% end %>
</nav>

<details class="relative">
  <summary class="flex h-11 cursor-pointer list-none items-center rounded-lg bg-chloro-600 px-3 text-sm font-semibold text-white marker:content-none">
    Réglages
  </summary>
  <div class="absolute right-0 top-[calc(100%+6px)] w-48 overflow-hidden rounded-lg border border-ash-200 bg-white text-sm shadow-lg">
    <%= link_to "Profil & besoins", profile_path, class: "block px-4 py-3 text-ash-900 hover:bg-chloro-50" %>
    <%= link_to "Cibles nutritionnelles", nutrition_target_path, class: "block px-4 py-3 text-ash-900 hover:bg-chloro-50" %>
    <%= button_to "Déconnexion", session_path, method: :delete,
          class: "block w-full border-t border-ash-100 px-4 py-3 text-left text-ash-500 hover:bg-chloro-50" %>
  </div>
</details>

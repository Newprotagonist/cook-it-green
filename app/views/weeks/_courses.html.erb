<% total_lines = week.shopping_list.sum { |_, lines| lines.size } %>

<p class="mb-5 max-w-3xl border-l-2 border-chloro-700 pl-4 text-sm text-ash-500">
  Quantités pour <strong>une personne, sept jours</strong> — trois plats, sept petits-déjeuners et
  sept collations compris. Légumineuses et céréales en <strong>poids sec</strong>.
  Le gluten de blé remplace le seitan : 100 g de seitan cuit = 33 g de gluten sec.
</p>

<%# Desktop : grille de cartes, inchangée dans sa structure. %>
<div class="hidden gap-4 sm:grid-cols-2 lg:grid lg:grid-cols-3">
  <% week.shopping_list.each do |aisle, lines| %>
    <section class="rounded border border-ash-200 bg-white p-5">
      <h3 class="mb-3 text-[10px] font-semibold uppercase tracking-widest text-ash-500"><%= aisle %></h3>
      <ul class="text-sm">
        <% lines.each do |line| %>
          <li class="flex justify-between gap-3 border-b border-dotted border-ash-200 py-1 last:border-0">
            <span>
              <%= line.ingredient.name %>
              <% if line.note %><span class="block text-xs text-ash-500"><%= line.note %></span><% end %>
            </span>
            <span class="whitespace-nowrap tabular-nums text-ash-500">
              <%= line.grams >= 1000 ? "#{number_with_precision(line.grams / 1000.0, precision: 1)} kg" : "#{line.grams} g" %>
            </span>
          </li>
        <% end %>
      </ul>
    </section>
  <% end %>
</div>

<%# Mobile : liste continue, en-têtes de rayon collants, cases à cocher persistées (2e). %>
<div class="-mx-5 lg:hidden" data-controller="checklist" data-checklist-storage-key-value="courses:<%= week.number %>">
  <p class="mb-3 px-5 text-xs font-semibold tabular-nums text-ash-500">
    <span data-checklist-target="count">0 / <%= total_lines %></span> articles cochés
  </p>
  <% week.shopping_list.each do |aisle, lines| %>
    <div>
      <div class="sticky top-[52px] z-10 flex items-center justify-between bg-chloro-700 px-5 py-2">
        <span class="text-[11px] font-bold uppercase tracking-widest text-white"><%= aisle %></span>
        <span class="text-[11px] font-semibold tabular-nums text-chloro-200"><%= lines.size %></span>
      </div>
      <% lines.each do |line| %>
        <button type="button" data-action="click->checklist#toggle" data-key="<%= aisle %>|<%= line.ingredient.key %>" data-checklist-target="item"
                class="flex min-h-16 w-full items-center gap-3.5 border-b border-ash-100 bg-white px-5 py-2.5 text-left">
          <span data-checklist-box class="flex h-6 w-6 flex-none items-center justify-center rounded-full border-[1.5px] border-ash-300 bg-white text-xs font-bold text-white"></span>
          <span data-checklist-strike class="flex-1">
            <span class="block text-[15px] leading-tight text-ash-900"><%= line.ingredient.name %></span>
            <% if line.note %><span class="block text-xs text-ash-500"><%= line.note %></span><% end %>
          </span>
          <span class="whitespace-nowrap text-[15px] font-bold tabular-nums text-chloro-700">
            <%= line.grams >= 1000 ? "#{number_with_precision(line.grams / 1000.0, precision: 1)} kg" : "#{line.grams} g" %>
          </span>
        </button>
      <% end %>
    </div>
  <% end %>
</div>

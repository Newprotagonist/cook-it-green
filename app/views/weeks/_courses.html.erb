<p class="mb-5 max-w-3xl border-l-2 border-stone-900 pl-4 text-sm text-stone-600">
  Quantités pour <strong>une personne, sept jours</strong> — trois plats, sept petits-déjeuners et
  sept collations compris. Légumineuses et céréales en <strong>poids sec</strong>.
  Le gluten de blé remplace le seitan : 100 g de seitan cuit = 33 g de gluten sec.
</p>

<div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
  <% week.shopping_list.each do |aisle, lines| %>
    <section class="rounded border border-stone-200 bg-white p-5">
      <h3 class="mb-3 text-[10px] font-semibold uppercase tracking-widest text-stone-500"><%= aisle %></h3>
      <ul class="text-sm">
        <% lines.each do |line| %>
          <li class="flex justify-between gap-3 border-b border-dotted border-stone-200 py-1 last:border-0">
            <span>
              <%= line.ingredient.name %>
              <% if line.note %><span class="block text-xs text-stone-400"><%= line.note %></span><% end %>
            </span>
            <span class="whitespace-nowrap tabular-nums text-stone-500">
              <%= line.grams >= 1000 ? "#{number_with_precision(line.grams / 1000.0, precision: 1)} kg" : "#{line.grams} g" %>
            </span>
          </li>
        <% end %>
      </ul>
    </section>
  <% end %>
</div>

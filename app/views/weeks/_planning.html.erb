<%# Desktop : tableau, inchangé dans sa structure. %>
<div class="hidden overflow-x-auto rounded border border-ash-200 bg-white lg:block">
  <table class="w-full text-sm">
    <thead class="bg-ash-50 text-[10px] uppercase tracking-wider text-ash-400">
      <tr>
        <th class="px-4 py-2 text-left">Jour</th>
        <th class="px-4 py-2 text-left">Petit-déjeuner</th>
        <th class="px-4 py-2 text-left">Déjeuner</th>
        <th class="px-4 py-2 text-left">Collation</th>
        <th class="px-4 py-2 text-left">Dîner</th>
        <th class="px-4 py-2 text-right">kcal</th>
        <th class="px-4 py-2 text-right">P</th><th class="px-4 py-2 text-right">L</th>
        <th class="px-4 py-2 text-right">G</th><th class="px-4 py-2 text-right">F</th>
      </tr>
    </thead>
    <tbody class="divide-y divide-ash-100">
      <% week.days.each do |day| %>
        <tr class="<%= "bg-zest-300/15" if day.today %>">
          <td class="whitespace-nowrap px-4 py-2 font-medium">
            <%= day.name %>
            <% if day.today %><span class="ml-1 rounded-full bg-zest-400 px-1.5 py-0.5 text-[10px] font-bold uppercase tracking-wide text-chloro-950">aujourd'hui</span><% end %>
            <% if day.from_freezer %>
              <span class="ml-1 rounded border border-ash-300 px-1 text-[10px] uppercase tracking-wide text-ash-500">congél.</span>
            <% end %>
          </td>
          <td class="px-4 py-2 text-ash-500"><%= day.breakfast&.fixed_meal&.name %></td>
          <td class="px-4 py-2"><span class="mr-1 text-[10px] font-semibold text-chloro-600"><%= day.lunch_role %></span><%= day.lunch&.dish&.name %></td>
          <td class="px-4 py-2 text-ash-500"><%= day.snack&.fixed_meal&.name %></td>
          <td class="px-4 py-2"><span class="mr-1 text-[10px] font-semibold text-chloro-600"><%= day.dinner_role %></span><%= day.dinner&.dish&.name %></td>
          <td class="px-4 py-2 text-right tabular-nums"><%= kcal day.totals.kcal %></td>
          <% %i[protein lipid carb fiber].each do |m| %>
            <% v = day.totals.public_send(m); short = v < target.macro_minimums[m] - 0.05 %>
            <td class="px-4 py-2 text-right tabular-nums <%= 'font-semibold text-rose-600' if short %>">
              <%= number_with_precision v, precision: 1 %>
            </td>
          <% end %>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>

<%# Mobile : rail de cartes balayable, le repas en cours plein écran (2c « bras tendu »). %>
<div class="-mx-5 flex snap-x snap-mandatory gap-3 overflow-x-auto px-5 pb-1 lg:hidden">
  <% week.days.each do |day| %>
    <% now_meal, now_slot_label =
         if day.today && Menu::Calendar.now_slot == :lunch
           [ day.lunch, "Déjeuner" ]
         elsif day.today
           [ day.dinner, "Dîner" ]
         end %>
    <article class="w-[320px] flex-none snap-center rounded-xl <%= "border border-ash-200 bg-white" %> p-0">
      <div class="flex items-center justify-between gap-2 px-0.5 pb-2">
        <h2 class="text-lg font-extrabold tracking-tight <%= day.today ? "text-ash-900" : "text-ash-500" %>"><%= day.name %></h2>
        <span class="flex items-center gap-1.5">
          <% if day.today %><span class="rounded-full bg-zest-400 px-2 py-1 text-[9.5px] font-bold uppercase tracking-wide text-chloro-950">aujourd'hui</span><% end %>
          <% if day.from_freezer %><span class="rounded border border-ash-300 px-1.5 py-0.5 text-[9.5px] font-semibold uppercase tracking-wide text-ash-500">congél.</span><% end %>
        </span>
      </div>

      <% if now_meal %>
        <div class="rounded-xl bg-chloro-700 px-4 py-[18px]">
          <p class="text-[9.5px] font-bold uppercase tracking-widest text-chloro-200">Maintenant · <%= now_slot_label %></p>
          <p class="mt-2 text-2xl font-extrabold leading-tight tracking-tight text-white"><%= now_meal.dish.name %></p>
          <% if (revival = day.revival) %>
            <div class="mt-3.5 rounded-lg bg-chloro-900 px-3 py-2.5">
              <p class="text-[9.5px] font-bold uppercase tracking-widest text-zest-400">Relance</p>
              <p class="mt-1 text-[15px] leading-snug text-chloro-100"><%= revival %></p>
            </div>
          <% end %>
        </div>
      <% end %>

      <div class="mt-2.5 overflow-hidden rounded-xl border border-ash-200 bg-white">
        <% rest = [
             [ "Petit-déj", day.breakfast&.fixed_meal&.name, nil ],
             ([ "Déjeuner", day.lunch&.dish&.name, day.lunch_role ] unless now_meal == day.lunch),
             [ "Collation", day.snack&.fixed_meal&.name, nil ],
             ([ "Dîner", day.dinner&.dish&.name, day.dinner_role ] unless now_meal == day.dinner)
           ].compact %>
        <% rest.each do |slot, name, role| %>
          <div class="flex items-center justify-between gap-3 border-b border-ash-100 px-3.5 py-2 last:border-0">
            <span class="w-16 flex-none text-[10px] font-semibold uppercase tracking-wide text-ash-400"><%= slot %></span>
            <span class="flex-1 text-right text-sm text-ash-500"><%= role ? "#{role} · " : "" %><%= name %></span>
          </div>
        <% end %>
        <details class="group">
          <summary class="flex min-h-11 cursor-pointer list-none items-center justify-between bg-chloro-50 px-3.5 py-2 marker:content-none">
            <span class="text-[13px] font-bold tabular-nums text-chloro-700"><%= kcal day.totals.kcal %></span>
            <span class="text-xs font-medium text-chloro-600 group-open:hidden">Macros ⌄</span>
            <span class="hidden text-xs font-medium text-chloro-600 group-open:inline">Macros ⌃</span>
          </summary>
          <div class="grid grid-cols-4 border-t border-chloro-100 bg-chloro-50">
            <% [ [ "P", day.totals.protein ], [ "L", day.totals.lipid ], [ "G", day.totals.carb ], [ "F", day.totals.fiber ] ].each do |label, v| %>
              <div class="border-l border-chloro-100 py-2.5 text-center first:border-0">
                <p class="text-[9.5px] font-bold uppercase tracking-widest text-chloro-600"><%= label %></p>
                <p class="mt-0.5 text-sm font-bold tabular-nums text-chloro-900"><%= number_with_precision v, precision: 1 %></p>
              </div>
            <% end %>
          </div>
        </details>
      </div>
    </article>
  <% end %>
</div>

<div class="mt-6 max-w-2xl border-l-2 border-chloro-700 pl-4 text-sm text-ash-500">
  <p><strong>Vendredi, samedi et dimanche</strong> se servent des portions congelées le jour de la session :
     sortez-les la veille au réfrigérateur. Chaque jour porte une <strong>relance</strong>, deux minutes de
     travail qui changent la perception du plat :</p>
  <ul class="mt-2 list-disc space-y-1 pl-5">
    <% week.days.map(&:revival).compact.uniq.each do |revival| %><li><%= revival %></li><% end %>
  </ul>
</div>

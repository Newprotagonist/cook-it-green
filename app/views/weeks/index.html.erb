<% content_for :title, "Les 16 semaines" %>

<div class="mb-8">
  <p class="text-xs font-bold uppercase tracking-widest text-chloro-700">Rotation annuelle</p>
  <h1 class="mt-1 text-3xl font-extrabold tracking-tight text-ash-900">Seize semaines, quatre saisons</h1>
  <p class="mt-2 max-w-2xl text-ash-500">
    Trois plats par semaine, interchangeables entre midi et soir. Nous sommes en
    <strong><%= Menu::Calendar.label_for(@season).downcase %></strong><% if @current_week %>,
    semaine <strong><%= @current_week %></strong> de la rotation<% end %>.
    Prochaine session de batch : <strong><%= l Menu::Calendar.next_batch_session, format: :long %></strong>.
  </p>
</div>

<% unless @target&.resolved? %>
  <p class="mb-6 rounded border border-amber-200 bg-amber-50 px-4 py-3 text-sm text-amber-900">
    Aucune cible résolue pour l'instant.
    <%= link_to "Lancez un recalcul", nutrition_targets_path, class: "underline" %> pour générer les grammages.
  </p>
<% end %>

<% @weeks_by_season.each do |season, numbers| %>
  <section class="mb-10">
    <h2 class="sticky top-[52px] z-10 -mx-5 mb-3 bg-chloro-700 px-5 py-2 text-xs font-bold uppercase tracking-widest text-white lg:static lg:mx-0 lg:bg-transparent lg:px-0 lg:py-0 lg:text-ash-500">
      <%= Menu::Calendar.label_for(season) %>
    </h2>
    <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
      <% numbers.each do |number| %>
        <% current = number == @current_week %>
        <%= link_to week_path(number),
              class: "block rounded-xl border p-4 transition #{current ? 'border-chloro-700 bg-chloro-700 hover:border-chloro-600' : 'border-ash-200 bg-white hover:border-chloro-300'}" do %>
          <p class="flex items-baseline justify-between">
            <span class="font-extrabold tracking-tight <%= current ? 'text-white' : 'text-ash-900' %>">Semaine <%= number %></span>
            <% if current %>
              <span class="rounded-full bg-zest-400 px-2.5 py-0.5 text-[10px] font-bold uppercase tracking-wide text-chloro-950">en cours</span>
            <% end %>
          </p>
          <ul class="mt-2 space-y-1 text-sm <%= current ? 'text-chloro-100' : 'text-ash-500' %>">
            <% (@dishes_by_week[number] || []).each do |dish| %>
              <li class="line-clamp-1"><%= dish.name %></li>
            <% end %>
          </ul>
        <% end %>
      <% end %>
    </div>
  </section>
<% end %>
